<%- include('../partials/header', { pageTitle: 'จัดการอีเวนต์' }) %>
    <main class="tm-container tm-stack">
      <div class="tm-row">
        <h1 class="tm-h1">อีเวนต์ของฉัน</h1>
        <a class="tm-btn tm-btn-primary" href="/events/new">
          <svg class="tm-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          สร้างอีเวนต์ใหม่
        </a>
      </div>
      <% if (events.length === 0) { %>
        <div class="tm-empty">
          <div class="tm-empty-icon">
            <svg class="tm-icon-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#94a3b8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <h3 class="tm-h3" style="margin-bottom:8px">ยังไม่มีอีเวนต์ที่สร้าง</h3>
          <p class="tm-muted" style="margin-bottom:16px">เริ่มสร้างอีเวนต์แรกของคุณได้เลย</p>
          <a class="tm-btn tm-btn-primary" href="/events/new">
            <svg class="tm-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            สร้างอีเวนต์แรก
          </a>
        </div>
      <% } %>
      <div class="tm-grid tm-grid-md-2 tm-grid-lg-3">
        <% events.forEach(e => { %>
          <article class="tm-card">
            <img src="<%= thumbUrl(e, 360, 200) %>" alt="<%= e.title %>" loading="lazy" width="360" height="200" decoding="async" referrerpolicy="no-referrer" onerror="this.src='/placeholder.svg';this.onerror=null"
              <% if (isCloudinaryImage(e)) { %>
                srcset="<%= thumbSrcset(e) %>"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
              <% } %>
            />
            <div class="tm-card-body tm-stack">
              <h3 class="tm-h3"><%= e.title %></h3>
              <p class="tm-muted"><strong>วันที่:</strong> <%= new Date(e.date).toLocaleDateString('th-TH') %> · <strong>สถานที่:</strong> <%= e.location %></p>
              <p class="tm-muted"><strong>ราคา:</strong> <%= e.price === 0 ? 'ฟรี' : e.price + ' ฿' %> · <strong>ขายแล้ว:</strong> <%= e.ticketsSold || 0 %></p>
              <div style="display:flex;flex-wrap:wrap;gap:12px;padding-top:4px">
                <a class="tm-btn tm-btn-outline" href="/events/<%= e._id %>">
                  <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                  ดูรายละเอียด
                </a>
                <% const hasCoords = typeof e.lat !== 'undefined' && typeof e.lng !== 'undefined'; %>
                <a class="tm-btn tm-btn-outline" target="_blank" rel="noopener" href="<%= hasCoords ? ('https://www.google.com/maps/search/?api=1&query=' + e.lat + ',' + e.lng) : ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(e.location)) %>">
                  <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6-5.33-6-10a6 6 0 1112 0c0 4.67-6 10-6 10z"/><circle cx="12" cy="11" r="2"/></svg>
                  เปิดแผนที่
                </a>
                <a class="tm-btn tm-btn-outline" href="/events/<%= e._id %>/edit">
                  <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                  แก้ไข
                </a>
                <form action="/events/<%= e._id %>/delete" method="post" style="display:inline">
                  <button type="submit" aria-label="ลบอีเวนต์นี้" class="tm-btn tm-btn-outline-danger" onclick="return confirm('ลบอีเวนต์นี้?')">
                    <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    ลบ
                  </button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </main>
<%- include('../partials/footer') %>
<%- include('../partials/header', { pageTitle: 'เข้าสู่ระบบ' }) %>
    <!-- Toast Container -->
    <%- include('../partials/toast') %>
    
    <main class="auth-main">
      <div class="tm-container tm-stack" style="max-width: 640px;">
        <!-- Header -->
        <div class="tm-center tm-stack">
          <div class="tm-circle" style="background: var(--primary); margin: 0 auto 1rem;">
            <svg class="tm-icon" style="color: #fff;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <h1 class="tm-h1">เข้าสู่ระบบ</h1>
          <p class="tm-muted">ยินดีต้อนรับกลับสู่ TicketManager</p>
        </div>

        <!-- Login Form -->
        <div class="tm-card">
          <div class="tm-card-body tm-stack">
            <form action="/login" method="post" class="tm-stack">
              <!-- Email Field -->
              <div class="tm-stack">
                <label for="email">อีเมล</label>
                <div class="tm-field">
                  <span class="tm-input-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                    </svg>
                  </span>
                  <input 
                    id="email"
                    type="email" 
                    name="email" 
                    required 
                    autocomplete="email" 
                    autofocus 
                    class="tm-input"
                    style="padding-left: 2.25rem;"
                    placeholder="กรอกอีเมลของคุณ"
                  />
                </div>
              </div>

              <!-- Password Field -->
              <div class="tm-stack">
                <label for="password">รหัสผ่าน</label>
                <div class="tm-field">
                  <span class="tm-input-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                  </span>
                  <input 
                    id="password"
                    type="password" 
                    name="password" 
                    required 
                    autocomplete="current-password" 
                    class="tm-input"
                    style="padding-left: 2.25rem;"
                    placeholder="กรอกรหัสผ่านของคุณ"
                  />
                </div>
              </div>

              <!-- Remember Me & Forgot Password -->
              <div style="display:flex; align-items:center; justify-content:space-between;">
                <div style="display:flex; align-items:center; gap:8px;">
                  <input id="remember-me" name="remember-me" type="checkbox" />
                  <label for="remember-me">จดจำการเข้าสู่ระบบ</label>
                </div>
                <div>
                  <a href="#" style="color: var(--primary);">ลืมรหัสผ่าน?</a>
                </div>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="tm-btn tm-btn-primary">
                <svg class="tm-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                </svg>
                เข้าสู่ระบบ
              </button>
            </form>

            <!-- Divider -->
            <hr style="border:0; border-top:1px solid rgba(0,0,0,0.08);" />

            <!-- Register Link -->
            <div class="tm-center">
              <p class="tm-muted">
                ยังไม่มีบัญชี? 
                <a href="/register" style="color: var(--primary);">สมัครสมาชิกที่นี่</a>
              </p>
            </div>
          </div>
        </div>

        <!-- Back to Home -->
        <div class="tm-center" style="margin-top: 1rem;">
          <a href="/" style="display:inline-flex; align-items:center; gap:8px; color: var(--text-muted);">
            <svg class="tm-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            กลับสู่หน้าหลัก
          </a>
        </div>
      </div>
    </main>

<%- include('../partials/footer') %>
<header class="tm-nav">
  <div class="tm-container tm-nav-inner">
    <div style="display:flex;align-items:center;gap:8px">
      <button id="tm-nav-toggle" class="tm-nav-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false" aria-controls="tm-nav-menu">
        <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/></svg>
      </button>
      <a class="tm-brand" href="/">Eเวร Ticket</a>
    </div>
    <form action="/" method="get" class="tm-search">
      <input class="tm-input" type="text" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="ค้นหาอีเวนต์..." autocomplete="off">
      <button class="tm-btn tm-btn-primary" type="submit">
        <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        ค้นหา
      </button>
    </form>
    <nav id="tm-nav-menu" class="tm-nav-menu">
      <% if (currentUser) { %>
        <% if (currentUser.role !== 'organizer') { %>
          <a class="tm-badge tm-badge-primary" href="/wallet" title="เครดิตคงเหลือ" aria-label="เครดิตคงเหลือ">
            <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 15a2 2 0 100-4 2 2 0 000 4z"/></svg>
            เครดิต: <%= (Number(currentUser.creditBalanceCents || 0) / 100).toLocaleString('th-TH') %> ฿
          </a>
        <% } %>

        <div class="tm-user-dropdown">
          <button id="tm-avatar-btn" class="tm-avatar-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="tm-profile-menu">
            <span class="tm-avatar"><%= (currentUser.name || 'U').trim().charAt(0).toUpperCase() %></span>
            <span class="tm-caret" aria-hidden="true"></span>
          </button>
          <div id="tm-profile-menu" class="tm-dropdown" role="menu">
            <% if (currentUser.role === 'organizer') { %>
              <a class="tm-dropdown-item" href="/scan" role="menuitem" title="สแกนตรวจตั๋ว" aria-label="สแกนตรวจตั๋ว">
                <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 7V5a2 2 0 012-2h2"/>
                  <path d="M21 7V5a2 2 0 00-2-2h-2"/>
                  <path d="M3 17v2a2 2 0 002 2h2"/>
                  <path d="M21 17v2a2 2 0 01-2 2h-2"/>
                </svg>
                สแกนตรวจตั๋ว
              </a>
              <a class="tm-dropdown-item" href="/dashboard" role="menuitem">
                <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h7v7H3z"/><path d="M14 3h7v7h-7z"/><path d="M14 14h7v7h-7z"/><path d="M3 14h7v7H3z"/></svg>
                แดชบอร์ด
              </a>
              <a class="tm-dropdown-item" href="/events/manage" role="menuitem">
                <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                จัดการอีเวนต์
              </a>
              <div class="tm-dropdown-divider"></div>
            <% } %>
            <a class="tm-dropdown-item" href="/profile" role="menuitem">
              <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0z"/><path d="M12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              หน้าโปรไฟล์
            </a>
            <a class="tm-dropdown-item" href="/profile#orders" role="menuitem">
              <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9v6a2 2 0 002 2h10a2 2 0 002-2v-1a2 2 0 000-4v-1a2 2 0 00-2-2H5a2 2 0 00-2 2z"/><path d="M8 9v6"/><path d="M12 9v6"/></svg>
              ตั๋วของฉัน
            </a>
            <a class="tm-dropdown-item" href="/settings/profile" role="menuitem">
              <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
              แก้ไขข้อมูลส่วนตัว
            </a>
            <a class="tm-dropdown-item" href="/settings/security" role="menuitem">
              <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 11V7a5 5 0 00-10 0v4"/><rect x="2" y="11" width="20" height="11" rx="2"/></svg>
              แก้ไขรหัสผ่าน
            </a>
            <a class="tm-dropdown-item" href="/wallet" role="menuitem">
              <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 15a2 2 0 100-4 2 2 0 000 4z"/></svg>
              เครดิตของฉัน
            </a>
            <div class="tm-dropdown-divider"></div>
            <form action="/logout" method="post" style="margin:0">
              <button class="tm-dropdown-item linklike" type="submit" role="menuitem">
                <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><path d="M10 17l-5-5 5-5"/><path d="M13 12H5"/></svg>
                ออกจากระบบ
              </button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a class="tm-btn tm-btn-primary" href="/login">เข้าสู่ระบบ</a>
        <a class="tm-btn tm-btn-outline" href="/register">สมัครสมาชิก</a>
      <% } %>
      <!-- Theme toggle (always visible) -->
      <button id="tm-theme-toggle" class="tm-theme-toggle" type="button" aria-label="สลับธีม" aria-pressed="false" title="สลับธีม">
        <!-- Default icon (updated by script) -->
        <svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      </button>
    </nav>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function(){
      var btn = document.getElementById('tm-nav-toggle');
      var menu = document.getElementById('tm-nav-menu');
      if(!btn || !menu) return;
      btn.addEventListener('click', function(){
        var opened = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', opened ? 'true' : 'false');
      });
      var avatarBtn = document.getElementById('tm-avatar-btn');
      var dropdown = document.getElementById('tm-profile-menu');
      if (avatarBtn && dropdown) {
        function closeDropdown(){ dropdown.classList.remove('open'); avatarBtn.setAttribute('aria-expanded','false'); }
        avatarBtn.addEventListener('click', function(e){
          e.stopPropagation();
          var opened = dropdown.classList.toggle('open');
          avatarBtn.setAttribute('aria-expanded', opened ? 'true' : 'false');
        });
        document.addEventListener('click', function(e){
          if (!dropdown.contains(e.target) && e.target !== avatarBtn) closeDropdown();
        });
        document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeDropdown(); });
      }

      // Theme toggle logic
      var themeBtn = document.getElementById('tm-theme-toggle');
      if (themeBtn) {
        var ICONS = {
          light: '<svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2"/><path d="M12 21v2"/><path d="M4.22 4.22l1.42 1.42"/><path d="M18.36 18.36l1.42 1.42"/><path d="M1 12h2"/><path d="M21 12h2"/><path d="M4.22 19.78l1.42-1.42"/><path d="M18.36 5.64l1.42-1.42"/></svg>',
          dark: '<svg class="tm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>'
        };
        function setTheme(theme){
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('tm_theme', theme);
          themeBtn.innerHTML = theme === 'dark' ? ICONS.light : ICONS.dark;
          themeBtn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
        }
        var saved = localStorage.getItem('tm_theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var current = saved || (prefersDark ? 'dark' : 'light');
        setTheme(current);
        themeBtn.addEventListener('click', function(){
          var now = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          setTheme(now);
        });
      }
    });
  </script>
</header>
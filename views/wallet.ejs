<%- include('./partials/header', { pageTitle: 'เครดิตของฉัน' }) %>
  <main class="tm-container tm-stack">
    <h1 class="tm-h1">เครดิตของฉัน</h1>
    <section class="tm-card">
      <div class="tm-card-body tm-stack">
        <p class="tm-muted">ยอดคงเหลือ:</p>
        <p style="font-size:28px;font-weight:700"> <%= (Number(balanceCents || 0) / 100).toLocaleString('th-TH') %> ฿</p>
        <form action="/wallet/deposit" method="post" class="tm-stack" style="max-width:360px">
          <label class="tm-field">ฝากเครดิต (฿)
            <input type="number" step="0.01" min="1" name="amount" value="<%= formData?.amount || '' %>" required class="tm-input" />
          </label>
          <button class="tm-btn tm-btn-primary" type="submit">
            ฝากเครดิต
          </button>
          <p class="tm-muted" style="font-size:12px">ระบบนี้เป็นการจำลองการชำระเงินและจัดการเครดิตอย่างปลอดภัย โดยเก็บยอดในหน่วยสตางค์</p>
        </form>
      </div>
    </section>

    <section class="tm-card">
      <div class="tm-card-body tm-stack">
        <h2 class="tm-h3" style="margin-top:0">ประวัติธุรกรรมล่าสุด</h2>
        <% if (!txs || txs.length === 0) { %>
          <p class="tm-muted">ยังไม่มีธุรกรรม</p>
        <% } else { %>
          <div class="tm-stack">
            <% txs.forEach(t => { %>
              <article class="tm-card" style="margin:0">
                <div class="tm-card-body" style="display:flex;justify-content:space-between;align-items:center">
                  <div>
                    <strong><%= t.type === 'deposit' ? 'ฝากเครดิต' : (t.type === 'charge' ? 'ตัดเครดิต' : 'คืนเงิน') %></strong>
                    <% if (t.note) { %><span class="tm-muted"> — <%= t.note %></span><% } %>
                    <div class="tm-muted" style="font-size:12px"><%= new Date(t.createdAt).toLocaleString('th-TH') %></div>
                  </div>
                  <div style="text-align:right">
                    <div style="font-weight:700;color:<%= t.type === 'deposit' ? '#0a7' : (t.type === 'charge' ? '#d00' : '#555') %>">
                      <%= (Number(t.amountCents || 0) / 100).toLocaleString('th-TH') %> ฿
                    </div>
                    <div class="tm-muted" style="font-size:12px">คงเหลือหลังทำรายการ: <%= (Number(t.balanceAfterCents || 0) / 100).toLocaleString('th-TH') %> ฿</div>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
  </main>
<%- include('./partials/footer') %>